#include "../lygia.msl"

#ifndef FNC_POW7
#define FNC_POW7

LYGIA_FNC float pow7(const float v) { return v * v * v * v * v * v * v; }
LYGIA_FNC float2 pow7(const float2 v) { return v * v * v * v * v * v * v; }
LYGIA_FNC float3 pow7(const float3 v) { return v * v * v * v * v * v * v; }
LYGIA_FNC float4 pow7(const float4 v) { return v * v * v * v * v * v * v; }

#endif
