#include "../lygia.msl"

#ifndef FNC_MOD
#define FNC_MOD

// Scalar mod function (float)
LYGIA_FNC float mod(float x, float y) { return x - y * floor(x / y); }

// Vector mod functions (float2, float3, float4)
LYGIA_FNC float2 mod(float2 x, float2 y) { return x - y * floor(x / y); }
LYGIA_FNC float3 mod(float3 x, float3 y) { return x - y * floor(x / y); }
LYGIA_FNC float4 mod(float4 x, float4 y) { return x - y * floor(x / y); }

// Scalar mod function with scalar divisor (float2, float3, float4)
LYGIA_FNC float2 mod(float2 x, float y) { return mod(x, float2(y)); }
LYGIA_FNC float3 mod(float3 x, float y) { return mod(x, float3(y)); }
LYGIA_FNC float4 mod(float4 x, float y) { return mod(x, float4(y)); }

#endif
