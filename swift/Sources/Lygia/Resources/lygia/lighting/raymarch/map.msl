#include "../../lygia.msl"

#include "../material.msl"
#include "../medium.msl"

/*
contributors:  Inigo Quiles
description: |
    Map of SDF functions to be declare.
    Define `Material raymarchMap(float3 pos)` in your shader (and `Medium raymarchVolumeMap(float3 pos)` when
    using RAYMARCH_VOLUME), before or after including the raymarch files; these prototypes match it.
    Metal: define it `static inline` (the prototypes use LYGIA_FNC, `static inline` by default), so each .metal file of your app can have its
    own scene without duplicate or shared symbols.
use: <Material> raymarchMap( in <float3> pos )
options:
    - RAYMARCH_MAP_FNC: default raymarchMap
    - RAYMARCH_VOLUME_MAP_FNC: default raymarchVolumeMap
examples:
    - /shaders/lighting_raymarching.frag
*/

#ifndef RAYMARCH_MAP_FNC
#define RAYMARCH_MAP_FNC raymarchMap
#endif

#ifndef RAYMARCH_VOLUME_MAP_FNC
#define RAYMARCH_VOLUME_MAP_FNC raymarchVolumeMap
#endif

#ifndef FNC_RAYMARCH_MAP
#define FNC_RAYMARCH_MAP

LYGIA_FNC Material RAYMARCH_MAP_FNC( float3 pos );
LYGIA_FNC Medium RAYMARCH_VOLUME_MAP_FNC( float3 pos );

#endif