#include "../space/depth2viewZ.msl"
#include "../space/screen2viewPosition.msl"

#include "../sampler.msl"

/*
contributors: Patricio Gonzalez Vivo
description: sample the view Position from depthmap texture
use: <float4> sampleViewPosition(<SAMPLER_TYPE> texDepth, <float2> st [, <float> near, <float> far [, <float4x4> projection]])
options:
    - SAMPLER_FNC(TEX, UV): optional depending the target version of GLSL (texture2D(...) or texture(...))
    - CAMERA_NEAR_CLIP: required
    - CAMERA_FAR_CLIP: required
    - CAMERA_ORTHOGRAPHIC_PROJECTION, if it's not present is consider a PERECPECTIVE camera
    - CAMERA_PROJECTION_MATRIX: float4x4 matrix with camera projection. Metal has no global uniforms, so the
      overloads without a projection argument only exist when this is defined to something in scope
    - INVERSE_CAMERA_PROJECTION_MATRIX: float4x4 matrix with the inverse camara projection
license:
    - Copyright (c) 2021 Patricio Gonzalez Vivo under Prosperity License - https://prosperitylicense.com/versions/3.0.0
    - Copyright (c) 2021 Patricio Gonzalez Vivo under Patron License - https://lygia.xyz/license
*/

#ifndef FNC_SAMPLEVIEWPOSITION
#define FNC_SAMPLEVIEWPOSITION
inline float4 sampleViewPosition(float depth, float2 st, float near, float far, float4x4 projection) {
    float viewZ = depth2viewZ(depth, near, far);
    return screen2viewPosition(st, depth, viewZ, projection);
}

inline float4 sampleViewPosition(SAMPLER_TYPE texDepth, float2 st, float near, float far, float4x4 projection) {
    float depth = SAMPLER_FNC(texDepth, st).r;
    float viewZ = depth2viewZ(depth, near, far);
    return screen2viewPosition(st, depth, viewZ, projection);
}

#ifdef CAMERA_PROJECTION_MATRIX
inline float4 sampleViewPosition(float depth, float2 st, float near, float far) {
    float viewZ = depth2viewZ(depth, near, far);
    return screen2viewPosition(st, depth, viewZ);
}

inline float4 sampleViewPosition(SAMPLER_TYPE texDepth, float2 st, float near, float far) {
    float depth = SAMPLER_FNC(texDepth, st).r;
    float viewZ = depth2viewZ(depth, near, far);
    return screen2viewPosition(st, depth, viewZ);
}

#if defined(CAMERA_NEAR_CLIP) && defined(CAMERA_FAR_CLIP)
inline float4 sampleViewPosition(SAMPLER_TYPE texDepth, float2 st) {
    return sampleViewPosition( texDepth, st, CAMERA_NEAR_CLIP, CAMERA_FAR_CLIP); 
}
#endif
#endif

#endif
