/*
contributors:  Inigo Quiles
description: generate the SDF of a plane
use: <float> planeSDF( <float3> pos, <float2> h ) 
*/

#include "../lygia.msl"

#ifndef FNC_PLANESDF
#define FNC_PLANESDF
LYGIA_FNC float planeSDF( float3 p ) { 
   return p.y; 
}

LYGIA_FNC float planeSDF(float3 p, float3 planePoint, float3 planeNormal) {
    return (dot(planeNormal, p) + dot(planeNormal, planePoint)) / length(planeNormal);
}
#endif