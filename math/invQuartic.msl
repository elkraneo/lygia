/*
contributors: Inigo Quiles
description: inverse quartic polynomial https://iquilezles.org/articles/smoothsteps/
use: <float|float2|float3|float4> invQuartic(<float|float2|float3|float4> value);
examples:
    - https://raw.githubusercontent.com/patriciogonzalezvivo/lygia_examples/main/math_functions.frag
*/

#include "../lygia.msl"

#ifndef FNC_INVQUARTIC
#define FNC_INVQUARTIC 
LYGIA_FNC float invQuartic(const float v) { return sqrt(1.0-sqrt(1.0-v)); }
LYGIA_FNC float2  invQuartic(const float2 v)  { return sqrt(1.0-sqrt(1.0-v)); }
LYGIA_FNC float3  invQuartic(const float3 v)  { return sqrt(1.0-sqrt(1.0-v)); }
LYGIA_FNC float4  invQuartic(const float4 v)  { return sqrt(1.0-sqrt(1.0-v)); }
#endif