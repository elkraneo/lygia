// @claim triangle distanceSq returns the squared distance
// @include geometry/triangle/distanceSq
// @before 23148b2a^
// @expect 0 4.0
// @note It returned sqrt(...), the distance, in every language. The point is 2 above the triangle's interior, so the squared distance is 4.
Triangle t;
t.a = vec3(0.0, 0.0, 0.0);
t.b = vec3(1.0, 0.0, 0.0);
t.c = vec3(0.0, 1.0, 0.0);
results[0] = vec4(distanceSq(t, vec3(0.25, 0.25, 2.0)), 0.0, 0.0, 0.0);
