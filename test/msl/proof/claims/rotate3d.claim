// @claim rotate3d turns vectors the same way as GLSL
// @include math/rotate3d
// @count 3
// @note GLSL and HLSL changed the rotation direction in 9a3a036c (2024); the Metal files kept the old matrices.
mat3 m = rotate3d(normalize(vec3(1.0, 2.0, 3.0)), 1.0);
results[0] = vec4(m * vec3(1.0, 0.0, 0.0), 0.0);
results[1] = vec4(m * vec3(0.0, 1.0, 0.0), 0.0);
results[2] = vec4(m * vec3(0.0, 0.0, 1.0), 0.0);
