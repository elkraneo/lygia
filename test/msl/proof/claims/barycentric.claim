// @claim barycentric weights sum to 1 and rebuild the point
// @include geometry/triangle/barycentric
// @count 2
// @before 23148b2a^
// @expect 0 0.5 0.2 0.3 1.0
// @expect 1 0.2 0.3 0.0
// @note It divided the sub-triangle cross products (twice their areas) by the area, so the weights summed to 2, in every language. "before" is the Metal port before the fix (the triangle module isn't on upstream main). For the point (0.2, 0.3) in the triangle (0,0), (1,0), (0,1), [0] is the weights and their sum, [1] is the point rebuilt from them.
Triangle t;
t.a = vec3(0.0, 0.0, 0.0);
t.b = vec3(1.0, 0.0, 0.0);
t.c = vec3(0.0, 1.0, 0.0);
vec3 w = barycentric(t, vec3(0.2, 0.3, 0.0));
results[0] = vec4(w, w.x + w.y + w.z);
results[1] = vec4(w.x * t.a + w.y * t.b + w.z * t.c, 0.0);
