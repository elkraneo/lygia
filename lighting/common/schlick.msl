#include "../../math/pow5.msl"

#ifndef FNC_SCHLICK
#define FNC_SCHLICK

// Schlick 1994, "An Inexpensive BRDF Model for Physically-Based Rendering"
static inline float3 schlick(float3 f0, float f90, float VoH) {
    float f = pow5(1.0 - VoH);
    return f + f0 * (f90 - f);
}

static inline float3 schlick(float3 f0, float3 f90, float VoH) {
    return f0 + (f90 - f0) * pow5(1.0 - VoH);
}

static inline float schlick(float f0, float f90, float VoH) {
    return f0 + (f90 - f0) * pow5(1.0 - VoH);
}

#endif