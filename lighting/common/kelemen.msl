
#include "../../lygia.msl"

#include "../../math/saturateMediump.msl"

#ifndef FNC_KELEMEN
#define FNC_KELEMEN

// Kelemen 2001, "A Microfacet Based Coupled Specular-Matte BRDF Model with Importance Sampling"
LYGIA_FNC float kelemen(float LoH) {
    return saturateMediump(0.25 / (LoH * LoH));
}

#endif