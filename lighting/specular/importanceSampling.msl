#include "../../math/hammersley.msl"
#include "../../math/rotate3dZ.msl"
#include "../../space/tbn.msl"
#include "../../generative/random.msl"
#include "../common/ggx.msl"
#include "../common/smithGGXCorrelated.msl"
#include "../fresnel.msl"
#include "../common/preFilteredImportanceSampling.msl"

/*
contributors:  Shadi El Hajj
description: |
    Sample the environment map using importance sampling.
    Metal has no global textures, so instead of SCENE_CUBEMAP the cubemap is passed as the last argument.
use: <float3> specularImportanceSampling(<float> roughness, <float3> f0, <float3> p, <float3> n, <float3> v, <float3> r, <float> NoV, out <float3> energyCompensation, <texturecube<float>> cubemap)
options:
    - IBL_IMPORTANCE_SAMPLING_SAMPLES: default 16
    - ENVMAP_SAMPLER: sampler for the cubemap. Default sampler(filter::linear, mip_filter::linear)
    - SAMPLE_CUBE_FNC(CUBEMAP, NORM, LOD): default CUBEMAP.sample(ENVMAP_SAMPLER, NORM, level(LOD))
license: MIT License (MIT) Copyright (c) 2024 Shadi EL Hajj
*/

#ifndef IBL_IMPORTANCE_SAMPLING_SAMPLES
#define IBL_IMPORTANCE_SAMPLING_SAMPLES  16
#endif

#ifndef ENVMAP_SAMPLER
#define ENVMAP_SAMPLER sampler(filter::linear, mip_filter::linear)
#endif

#ifndef SAMPLE_CUBE_FNC
#define SAMPLE_CUBE_FNC(CUBEMAP, NORM, LOD) CUBEMAP.sample(ENVMAP_SAMPLER, NORM, level(LOD))
#endif

#ifndef FNC_SPECULAR_IMPORTANCE_SAMPLING
#define FNC_SPECULAR_IMPORTANCE_SAMPLING

static inline float3 specularImportanceSampling(float roughness, float3 f0, float3 p, float3 n, float3 v, float3 r, float NoV, thread float3& energyCompensation, texturecube<float> cubemap) {
    const int numSamples = IBL_IMPORTANCE_SAMPLING_SAMPLES;
    const float invNumSamples = 1.0 / float(IBL_IMPORTANCE_SAMPLING_SAMPLES);
    const float3 up = float3(0.0, 0.0, 1.0);
    float3x3 T = tbn(n, up);
    // T *= rotate3dZ(TWO_PI * random(p));

    float width = float(cubemap.get_width());
    float omegaP = (4.0 * PI) / (6.0 * width * width);

    float3 indirectSpecular = float3(0.0, 0.0, 0.0);
    float dfg2 = 0.0;
    for (int i = 0; i < numSamples; i++) {
        float2 u = hammersley(uint(i), numSamples);
        float3 h = T * importanceSamplingGGX(u, roughness);
        float3 l = reflect(-v, h);

        float NoL = saturate(dot(n, l));
        if (NoL > 0.0) {
            float NoH = dot(n, h);
            float LoH = max(dot(l, h), EPSILON);

            float D = GGX(n, h, NoH, roughness);
            float V = smithGGXCorrelated(NoV, NoL, roughness);
            float3 F = fresnel(f0, LoH);

            float ipdf = (4.0 * LoH) / (D * NoH);
            float mipLevel = prefilteredImportanceSampling(ipdf, omegaP, numSamples);
            float3 L = SAMPLE_CUBE_FNC(cubemap, l, mipLevel).rgb;

            float3 Fr = F * (D * V * NoL * ipdf * invNumSamples);

            indirectSpecular += (Fr * L);

            dfg2 += V*LoH*NoL/NoH;
        }
    }

    dfg2 = 4.0 * dfg2 * invNumSamples;

    energyCompensation = (dfg2 > 0.0) ? (1.0 + f0 * (1.0 / dfg2 - 1.0)) : float3(1.0, 1.0, 1.0);

    return indirectSpecular;
}

#endif