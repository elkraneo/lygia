#include "directional.msl"
#include "point.msl"
#include "../shadow.msl"

/*
contributors: Patricio Gonzalez Vivo
description: |
    Light constructors from the LIGHT_* defines. A directional light when LIGHT_DIRECTION is defined,
    a point light when LIGHT_POSITION is defined.
    Metal has no global textures, so unlike GLSL the intensity is not multiplied by the LIGHT_SHADOWMAP
    shadow. Multiply it yourself: L.intensity *= shadow(shadowMap, shadowMapSize, lightCoord.xy, lightCoord.z)
use:
    - void lightNew(out <LightDirectional> L)
    - <LightDirectional> LightDirectionalNew()
    - void lightNew(out <LightPoint> L)
    - <LightPoint> LightPointNew()
options:
    - LIGHT_DIRECTION
    - LIGHT_POSITION
    - LIGHT_COLOR
    - LIGHT_INTENSITY
    - LIGHT_FALLOFF
    - SURFACE_POSITION
license:
    - Copyright (c) 2021 Patricio Gonzalez Vivo under Prosperity License - https://prosperitylicense.com/versions/3.0.0
    - Copyright (c) 2021 Patricio Gonzalez Vivo under Patron License - https://lygia.xyz/license
*/

// Each constructor has its own guard, so including this file again once LIGHT_DIRECTION or
// LIGHT_POSITION are defined adds the missing one
#if defined(LIGHT_DIRECTION) && !defined(FNC_LIGHT_NEW_DIRECTIONAL)
#define FNC_LIGHT_NEW_DIRECTIONAL
#define FNC_LIGHT_NEW
inline void lightNew(thread LightDirectional& _L) {
    _L.direction    = normalize(LIGHT_DIRECTION);

    #ifdef LIGHT_COLOR
    _L.color        = LIGHT_COLOR;
    #else 
    _L.color        = float3(1.0);
    #endif

    #ifdef LIGHT_INTENSITY
    _L.intensity    = LIGHT_INTENSITY;
    #else
    _L.intensity    = 1.0;
    #endif
}

inline LightDirectional LightDirectionalNew() { LightDirectional l; lightNew(l); return l; }
#endif

#if defined(LIGHT_POSITION) && !defined(FNC_LIGHT_NEW_POINT)
#define FNC_LIGHT_NEW_POINT
#define FNC_LIGHT_NEW

inline void lightNew(thread LightPoint& _L) {
    #if defined(SURFACE_POSITION)
    _L.position     = LIGHT_POSITION - SURFACE_POSITION.xyz;
    #else
    _L.position     = LIGHT_POSITION;
    #endif
    
    #ifdef LIGHT_COLOR
    _L.color        = LIGHT_COLOR;
    #else 
    _L.color        = float3(1.0);
    #endif

    #ifdef LIGHT_INTENSITY
    _L.intensity    = LIGHT_INTENSITY;
    #else
    _L.intensity    = 1.0;
    #endif

    #ifdef LIGHT_FALLOFF
    _L.falloff      = LIGHT_FALLOFF;
    #else
    _L.falloff      = 0.0;
    #endif
}

inline LightPoint LightPointNew() {
    LightPoint l;
    lightNew(l);
    return l;
}
#endif
