#include "../math/saturate.msl"
#include "../space/linearizeDepth.msl"
#include "../space/depth2viewZ.msl"
#include "../sampler.msl"
#include "../generative/random.msl"
#include "../math/mod.msl"
/*
contributors: Patricio Gonzalez Vivo
description: |
    ScreenSpace Ambient Occlusion.
    Metal has no global uniforms or gl_FragCoord, so the camera near/far clip, the projection matrix and the
    half-sphere samples are explicit arguments. The overloads without them only exist when CAMERA_NEAR_CLIP /
    CAMERA_FAR_CLIP or SSAO_SAMPLES_ARRAY / CAMERA_PROJECTION_MATRIX are defined to something in scope (e.g.
    a program-scope constant array). The SSAO_NOISE_ARRAY tiling uses the pixel coordinate derived from st
    (st / pixel for the depth version, st * texPosition size for the position/normal version).
use:
    - <float> ssao(<SAMPLER_TYPE> texDepth, <float2> st, <float2> pixel, <float> radius [, <float> cameraNear, <float> cameraFar])
    - <float> ssao(<SAMPLER_TYPE> texDepth, <float2> st)
    - <float> ssao(<SAMPLER_TYPE> texPosition, <SAMPLER_TYPE> texNormal, <float2> st, <float> radius [, <constant float3*> samples, <int> samplesNum, <float4x4> projection])
options:
    - SSAO_SAMPLES_NUM: number of half-sphere offsets samples
    - SSAO_SAMPLES_ARRAY: array of weighted float3 half-sphere offsets (SSAO_SAMPLES_NUM of them)
    - SSAO_NOISE_NUM: number of float3 noise offsets
    - SSAO_NOISE_ARRAY: array of float3 noise offsets
    - SSAO_NOISE2_FNC(ST): (random2(ST * 100.) * 0.1)
    - SSAO_NOISE3_FNC(POS): (random3(POS) * 0.3)
    - CAMERA_PROJECTION_MATRIX: camera projection float4x4 matrix
    - CAMERA_NEAR_CLIP: required for depth only SSAO
    - CAMERA_FAR_CLIP: required for depth only SSAO
    - SAMPLER_FNC(TEX, UV): optional depending the target version of GLSL (texture2D(...) or texture(...))
license:
    - Copyright (c) 2021 Patricio Gonzalez Vivo under Prosperity License - https://prosperitylicense.com/versions/3.0.0
    - Copyright (c) 2021 Patricio Gonzalez Vivo under Patron License - https://lygia.xyz/license
*/

#ifndef SSAO_SAMPLES
#define SSAO_SAMPLES 60.0
#endif

#ifndef SSAO_SAMPLES_NUM
#define SSAO_SAMPLES_NUM 8
#endif

#ifndef SSAO_NOISE_NUM
#define SSAO_NOISE_NUM 4
#endif

#ifndef SSAO_NOISE2_FNC
#define SSAO_NOISE2_FNC(ST) random2(ST)
#endif

#ifndef SSAO_NOISE3_FNC
#define SSAO_NOISE3_FNC(POS) random3(POS)
#endif

#ifndef SSAO_DEPTH_BIAS
#define SSAO_DEPTH_BIAS 0.05
#endif

#ifndef SSAO_DEPTH_SAMPLE_FNC
#define SSAO_DEPTH_SAMPLE_FNC(TEX, UV) SAMPLER_FNC(TEX, UV).r
#endif

#ifndef SSAO_POS_SAMPLE_FNC
#define SSAO_POS_SAMPLE_FNC(TEX, UV) SAMPLER_FNC(TEX, UV)
#endif

#ifndef SSAO_NORMAL_SAMPLE_FNC
#define SSAO_NORMAL_SAMPLE_FNC(TEX, UV) SAMPLER_FNC(TEX, UV).xyz
#endif

#ifndef FNC_SSAO
#define FNC_SSAO

inline float ssao(SAMPLER_TYPE texDepth, float2 st, float2 pixel, float radius, float cameraNear, float cameraFar) {

    #if defined(SSAO_NOISE_ARRAY)
    float2 fragCoord = st / pixel;
    float noiseS    = sqrt(float(SSAO_NOISE_NUM));
    int  noiseX     = int( mod(fragCoord.x - 0.5, noiseS) );
    int  noiseY     = int( mod(fragCoord.y - 0.5, noiseS) );
    float2 noise      = SSAO_NOISE_ARRAY[noiseX + noiseY * int(noiseS)].xy;
    #else
    float2 noise = SSAO_NOISE2_FNC( st ); 
    #endif
    noise *= 0.1;

    float depth     = depth2viewZ( SSAO_DEPTH_SAMPLE_FNC( texDepth, st ), cameraNear, cameraFar ) + SSAO_DEPTH_BIAS * 0.5; 
    float ao        = 0.0;

    // if (depth < 0.99) 
    {
        float w = pixel.x / depth + noise.x;
        float h = pixel.y / depth + noise.y;

        float dz = 1.0 / float( SSAO_SAMPLES_NUM ); 
        float l = 0.0; 
        float z = 1.0 - dz * 0.5; 

        for ( int i = 0; i < SSAO_SAMPLES_NUM; i ++ ) { 
            float r = sqrt( 1.0 - z ); 
            float pw = cos( l ) * r; 
            float ph = sin( l ) * r; 
            float2 vv = radius * float2( pw * w, ph * h);
            ao += ( step( depth2viewZ( SSAO_DEPTH_SAMPLE_FNC( texDepth, st + vv), cameraNear, cameraFar ), depth) + 
                    step( depth2viewZ( SSAO_DEPTH_SAMPLE_FNC( texDepth, st - vv), cameraNear, cameraFar ), depth) ) * 0.5;
            z = z - dz; 
            l = l + 2.399963229728653; 
        } 
        ao = 1.0 - ao * dz;
        ao = saturate( 1.98 * ( 1.0 - ao ) );
    }
    return ao;
}

#if defined(CAMERA_NEAR_CLIP) && defined(CAMERA_FAR_CLIP)
inline float ssao(SAMPLER_TYPE texDepth, float2 st, float2 pixel, float radius) {
    return ssao(texDepth, st, pixel, radius, CAMERA_NEAR_CLIP, CAMERA_FAR_CLIP);
}
#endif
inline float ssao(SAMPLER_TYPE texDepth, float2 coord) {
    float cd = SSAO_DEPTH_SAMPLE_FNC(texDepth, coord);
    float ao_radious = 1.0/100.0;
    float screenRadius = 0.5 * (ao_radious / cd) / 0.53135;
    float li = 0.0;
    float count = 0.0;
    for(float i=0.0; i< SSAO_SAMPLES; i++) {
        float3 p = normalize(SSAO_NOISE3_FNC(float3(coord, i)) * 2.0 - 1.0);
        float2 sp = float2(coord.x + p.x * screenRadius, coord.y + p.y * screenRadius);
        float d = SSAO_DEPTH_SAMPLE_FNC(texDepth, sp);
        float at = pow(length(p)-1.0, 2.0);
        li += step(cd + p.z * ao_radious, d) * at;
        count += at;
    }
    return 1.0 - li / count;
}

inline float ssao(SAMPLER_TYPE texPosition, SAMPLER_TYPE texNormal, float2 st, float radius, constant float3* samples, int samplesNum, float4x4 projection) {
    float4  position  = SSAO_POS_SAMPLE_FNC(texPosition, st);
    float3  normal    = SSAO_NORMAL_SAMPLE_FNC(texNormal, st);

    #if defined(SSAO_NOISE_ARRAY) 
    float2 fragCoord = st * float2(texPosition.get_width(), texPosition.get_height());
    float noiseS    = sqrt(float(SSAO_NOISE_NUM));
    int   noiseX    = int( mod(fragCoord.x - 0.5, noiseS) );
    int   noiseY    = int( mod(fragCoord.y - 0.5, noiseS) );
    float3  noise     = SSAO_NOISE_ARRAY[noiseX + noiseY * int(noiseS)];
    #else
    float3  noise     = SSAO_NOISE3_FNC( position.xyz ); 
    #endif

    float3 tangent    = normalize(noise - normal * dot(noise, normal));
    float3 binormal   = cross(normal, tangent);
    float3x3 tbn        = float3x3(tangent, binormal, normal);

    float occlusion = 0.0;
    for (int i = 0; i < samplesNum; ++i) {
        float3 samplePosition = tbn * samples[i];
        samplePosition = position.xyz + samplePosition * radius;

        float4 offsetUV = float4(samplePosition, 1.0);
        offsetUV = projection * offsetUV;
        offsetUV.xy /= offsetUV.w;
        offsetUV.xy = offsetUV.xy * 0.5 + 0.5;

        float sampleDepth = SAMPLER_FNC(texPosition, offsetUV.xy).z;
        float rangeCheck = smoothstep(0.0, 1.0, radius / abs(position.z - sampleDepth));
        occlusion += (sampleDepth >= samplePosition.z + SSAO_DEPTH_BIAS ? 1.0 : 0.0) * rangeCheck;
    }

    occlusion /= float(samplesNum);
    return 1.0-occlusion;
}

#if defined(SSAO_SAMPLES_ARRAY) && defined(CAMERA_PROJECTION_MATRIX)
inline float ssao(SAMPLER_TYPE texPosition, SAMPLER_TYPE texNormal, float2 st, float radius) {
    return ssao(texPosition, texNormal, st, radius, SSAO_SAMPLES_ARRAY, SSAO_SAMPLES_NUM, CAMERA_PROJECTION_MATRIX);
}
#endif
#endif