#include "../lygia.msl"

#ifndef FNC_CONTRASTMATRIX
#define FNC_CONTRASTMATRIX
LYGIA_FNC float4x4 contrastMatrix(float a) {
    float t = ( 1. - a ) * .5;
    return float4x4( a, .0, .0, .0,
                .0, a, .0, .0,
                .0, .0, a, .0,
                t,   t, t, 1. );
}
#endif
