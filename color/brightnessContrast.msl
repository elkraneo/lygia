/*
contributors: Patricio Gonzalez Vivo
description: modify brightness and contrast
use: brightnessContrast(<float|vec3|vec4> color, <float> brightness, <float> amcontrastount)
*/

#include "../lygia.msl"

#ifndef FNC_BRIGHTNESSCONTRAST
#define FNC_BRIGHTNESSCONTRAST
LYGIA_FNC float brightnessContrast( float v, float b, float c ) { return ( v - 0.5 ) * c + 0.5 + b; }
LYGIA_FNC float3 brightnessContrast( float3 v, float b, float c ) { return ( v - 0.5 ) * c + 0.5 + b; }
LYGIA_FNC float4 brightnessContrast( float4 v, float b, float c ) { return float4(( v.rgb - 0.5 ) * c + 0.5 + b, v.a); }
#endif