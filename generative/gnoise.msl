#ifndef GNOISE_NOISE_FNC
#define GNOISE_NOISE_FNC(UV) random(UV)
#endif

#ifndef GNOISE_NOISE2_FNC
#define GNOISE_NOISE2_FNC(UV) GNOISE_NOISE_FNC(UV)
#endif

#ifndef GNOISE_NOISE3_FNC
#define GNOISE_NOISE3_FNC(UV) GNOISE_NOISE_FNC(UV)
#endif

#ifndef GNOISE_NOISE_TILABLE_FNC
#define GNOISE_NOISE_TILABLE_FNC(UV, TILE) srandom3(UV, TILE)
#endif

#ifndef FNC_GNOISE
#define FNC_GNOISE

static inline float gnoise(float x) {
    float i = floor(x);  // integer
    float f = fract(x);  // fraction
    return mix(GNOISE_NOISE_FNC(i), GNOISE_NOISE_FNC(i + 1.0), smoothstep(0.,1.,f)); 
}

static inline float gnoise(float2 st) {
    float2 i = floor(st);
    float2 f = fract(st);
    float a = GNOISE_NOISE2_FNC(i);
    float b = GNOISE_NOISE2_FNC(i + float2(1.0, 0.0));
    float c = GNOISE_NOISE2_FNC(i + float2(0.0, 1.0));
    float d = GNOISE_NOISE2_FNC(i + float2(1.0, 1.0));
    float2 u = cubic(f);
    return mix( a, b, u.x) +
                (c - a)* u.y * (1.0 - u.x) +
                (d - b) * u.x * u.y;
}

static inline float gnoise(float3 p) {
    float3 i = floor(p);
    float3 f = fract(p);
    float3 u = quintic(f);
    return -1.0 + 2.0 * mix( mix( mix( GNOISE_NOISE3_FNC(i + float3(0.0,0.0,0.0)), 
                                        GNOISE_NOISE3_FNC(i + float3(1.0,0.0,0.0)), u.x),
                                mix( GNOISE_NOISE3_FNC(i + float3(0.0,1.0,0.0)), 
                                        GNOISE_NOISE3_FNC(i + float3(1.0,1.0,0.0)), u.x), u.y),
                            mix( mix( GNOISE_NOISE3_FNC(i + float3(0.0,0.0,1.0)), 
                                        GNOISE_NOISE3_FNC(i + float3(1.0,0.0,1.0)), u.x),
                                mix( GNOISE_NOISE3_FNC(i + float3(0.0,1.0,1.0)), 
                                        GNOISE_NOISE3_FNC(i + float3(1.0,1.0,1.0)), u.x), u.y), u.z );
}

static inline float gnoise(float3 p, float tileLength) {
    float3 i = floor(p);
    float3 f = fract(p);
            
    float3 u = quintic(f);
        
    return mix( mix( mix( dot( GNOISE_NOISE_TILABLE_FNC(i + float3(0.0,0.0,0.0), tileLength), f - float3(0.0,0.0,0.0)), 
                            dot( GNOISE_NOISE_TILABLE_FNC(i + float3(1.0,0.0,0.0), tileLength), f - float3(1.0,0.0,0.0)), u.x),
                    mix( dot( GNOISE_NOISE_TILABLE_FNC(i + float3(0.0,1.0,0.0), tileLength), f - float3(0.0,1.0,0.0)), 
                            dot( GNOISE_NOISE_TILABLE_FNC(i + float3(1.0,1.0,0.0), tileLength), f - float3(1.0,1.0,0.0)), u.x), u.y),
                mix( mix( dot( GNOISE_NOISE_TILABLE_FNC(i + float3(0.0,0.0,1.0), tileLength), f - float3(0.0,0.0,1.0)), 
                            dot( GNOISE_NOISE_TILABLE_FNC(i + float3(1.0,0.0,1.0), tileLength), f - float3(1.0,0.0,1.0)), u.x),
                    mix( dot( GNOISE_NOISE_TILABLE_FNC(i + float3(0.0,1.0,1.0), tileLength), f - float3(0.0,1.0,1.0)), 
                            dot( GNOISE_NOISE_TILABLE_FNC(i + float3(1.0,1.0,1.0), tileLength), f - float3(1.0,1.0,1.0)), u.x), u.y), u.z );
}

static inline float3 gnoise3(float3 x) {
    return float3(gnoise(x+float3(123.456, 0.567, 0.37)),
                gnoise(x+float3(0.11, 47.43, 19.17)),
                gnoise(x) );
}

#endif